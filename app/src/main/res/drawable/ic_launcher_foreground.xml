<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 背景 红‑橙渐变圆角方形 -->
    <path
        android:pathData="M18,0 L90,0 A18,18 0 0,1 108,18 L108,90 A18,18 0 0,1 90,108 L18,108 A18,18 0 0,1 0,90 L0,18 A18,18 0 0,1 18,0 Z"
        android:fillType="evenOdd">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startColor="#FF4242"
                android:endColor="#FF702E"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"/>
        </aapt:attr>
    </path>

    <!-- 锁身：白色圆角矩形 -->
    <path
        android:pathData="M24,40 L84,40 A8,8 0 0,1 92,48 L92,96 A8,8 0 0,1 84,104 L24,104 A8,8 0 0,1 16,96 L16,48 A8,8 0 0,1 24,40 Z"
        android:fillColor="#FFFFFF"/>

    <!-- 锁梁：白色 U 形 -->
    <path
        android:pathData="M34,40 L34,28 A20,20 0 0,1 74,28 L74,40"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="10"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent"/>

    <!-- 禁止圆环：深色空心圆 -->
    <path
        android:pathData="M54,68 m-20,0 a20,20 0 1,0 40,0 a20,20 0 1,0 -40,0"
        android:strokeColor="#FFEE2E2E"
        android:strokeWidth="4.0"
        android:fillColor="@android:color/transparent"/>

    <!-- 字母 AD：全部Y手动‑4上移 -->
    <group>
        <!-- 字母 A -->
        <path android:pathData="M44,74 L48,60 L51,60 L47,74 Z" android:fillColor="#FF1A1A24"/>
        <path android:pathData="M52,60 L56,74 L53,74 L49,60 Z" android:fillColor="#FF1A1A24"/>
        <path android:pathData="M46,67 L52,67 L52,69 L46,69 Z" android:fillColor="#FF1A1A24"/>

        <!-- 字母 D (空心轮廓) -->
        <path
            android:pathData="M58,60 L58,74"
            android:strokeColor="#FF1A1A24"
            android:strokeWidth="3.0"
            android:strokeLineCap="round"
            android:fillColor="@android:color/transparent"/>
        <path
            android:pathData="M58,60 A7,7 0 0,1 58,74"
            android:strokeColor="#FF1A1A24"
            android:strokeWidth="3.0"
            android:strokeLineCap="round"
            android:fillColor="@android:color/transparent"/>
    </group>

    <!-- 斜杠：深色粗圆头斜杠 -->
    <path
        android:pathData="M40,58 L68,78"
        android:strokeColor="#FFEE2E2E"
        android:strokeWidth="4.4"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent"/>

</vector>

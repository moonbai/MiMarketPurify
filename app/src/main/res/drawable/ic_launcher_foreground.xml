<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- ============================================= -->
    <!-- Layer 1: 外层圆角方形（Adaptive Icon 背景）      -->
    <!-- ============================================= -->
    <path
        android:pathData="M18,0 L90,0 A18,18 0 0,1 108,18 L108,90 A18,18 0 0,1 90,108 L18,108 A18,18 0 0,1 0,90 L0,18 A18,18 0 0,1 18,0 Z"
        android:fillColor="#FFFFFF"/>

    <!-- ============================================= -->
    <!-- Layer 2: 穹顶/拱门（橙→红渐变填充）              -->
    <!-- ============================================= -->
    <path
        android:pathData="M16,42 L16,22 A38,38 0 0,1 92,22 L92,42 Z"
        android:fillType="evenOdd">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="16"
                android:startY="22"
                android:endX="92"
                android:endY="42"
                android:startColor="#FF7043"
                android:endColor="#E53935"/>
        </aapt:attr>
    </path>

    <!-- ============================================= -->
    <!-- Layer 3: 穹顶白色竖条（商店门面格栅）            -->
    <!-- 用 clip-path 裁切到穹顶范围                      -->
    <!-- ============================================= -->
    <group>
        <clip-path android:pathData="M16,42 L16,22 A38,38 0 0,1 92,22 L92,42 Z"/>

        <!-- 竖条 1（左） -->
        <path
            android:pathData="M36,0 L40,0 L40,44 L36,44 Z"
            android:fillColor="#FFFFFF"/>
        <!-- 竖条 2（中） -->
        <path
            android:pathData="M52,0 L56,0 L56,44 L52,44 Z"
            android:fillColor="#FFFFFF"/>
        <!-- 竖条 3（右） -->
        <path
            android:pathData="M68,0 L72,0 L72,44 L68,44 Z"
            android:fillColor="#FFFFFF"/>
    </group>

    <!-- ============================================= -->
    <!-- Layer 4: 穹顶底边分隔线（微妙的深度感）          -->
    <!-- ============================================= -->
    <path
        android:pathData="M16,42 L92,42"
        android:strokeColor="#0000000D"
        android:strokeWidth="1.5"/>

    <!-- ============================================= -->
    <!-- Layer 5: 禁止圈（红色圆环）                      -->
    <!-- ============================================= -->
    <path
        android:pathData="M54,72 m-22,0 a22,22 0 1,0 44,0 a22,22 0 1,0 -44,0"
        android:strokeColor="#E53935"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"/>

    <!-- ============================================= -->
    <!-- Layer 6: 禁止圈斜线（左上→右下）                 -->
    <!-- ============================================= -->
    <path
        android:pathData="M38,56 L70,88"
        android:strokeColor="#E53935"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"/>

    <!-- ============================================= -->
    <!-- Layer 7: 字母 "AD"（深灰色粗体）                 -->
    <!-- ============================================= -->

    <!-- 字母 A 左斜笔画 -->
    <path
        android:pathData="M42,82 L48.5,60"
        android:strokeColor="#37474F"
        android:strokeWidth="5.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"/>
    <!-- 字母 A 右斜笔画 -->
    <path
        android:pathData="M48.5,60 L55,82"
        android:strokeColor="#37474F"
        android:strokeWidth="5.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"/>
    <!-- 字母 A 横杠 -->
    <path
        android:pathData="M44,74 L53,74"
        android:strokeColor="#37474F"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"/>

    <!-- 字母 D 竖笔画 -->
    <path
        android:pathData="M60,60 L60,82"
        android:strokeColor="#37474F"
        android:strokeWidth="5.5"
        android:strokeLineCap="round"/>
    <!-- 字母 D 圆弧 -->
    <path
        android:pathData="M60,60 Q72,60 72,71 Q72,82 60,82"
        android:strokeColor="#37474F"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="@android:color/transparent"/>

</vector>

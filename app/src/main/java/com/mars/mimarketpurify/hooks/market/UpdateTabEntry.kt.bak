package com.mars.mimarketpurify.hooks.market

import android.content.Intent
import android.util.Log
import com.mars.mimarketpurify.HookEnv
import com.mars.mimarketpurify.Settings
import com.mars.mimarketpurify.TAG
import com.mars.mimarketpurify.init.BaseHook
import io.github.kyuubiran.ezxhelper.core.finder.MethodFinder.`-Static`.methodFinder
import io.github.kyuubiran.ezxhelper.core.util.ClassUtil
import io.github.kyuubiran.ezxhelper.core.finder.FieldFinder.`-Static`.fieldFinder

object UpdateTabEntry : BaseHook() {

    override val prefKey: String = Settings.KEY_UPDATE_TAB
    override val name: String get() = "底栏更新入口"

    private const val UPDATE_TAG = "purify_update_entry"

    override fun init() {
        // ① TabInfo 注入
        hookTabInfoParse()
        // ② Tab 选中拦截
        hookTabSelection()
    }

    private fun hookTabInfoParse() {
        runCatching {
            val clazz = ClassUtil.loadClass("com.xiaomi.market.model.TabInfo")
            clazz.methodFinder()
                .filterByName("fromJSON")
                .filterByParamCount(1)
                .first()
                .hooked {
                    val result = proceed() as? List ?: return@hooked proceed()
                    if (!enabled()) return@hooked result

                    val list = result.toMutableList()
                    // 检查是否已注入（防止重复）
                    val already = list.any { item ->
                        runCatching { item.invokeAs("getTag") == UPDATE_TAG }.getOrDefault(false)
                    }
                    if (already) return@hooked list

                    // 构造 TabInfo：用反射创建，设置必要字段
                    val tabInfo = clazz.newInstance()
                    // tag 字段
                    clazz.getField("tag")?.set(tabInfo, UPDATE_TAG)
                    // titles 字段 (Map<String, String>)
                    clazz.getField("titles")?.set(tabInfo, mapOf("cn" to "更新", "en" to "Update"))
                    // 可能还有 icon / selectedIcon 字段，需要根据实际版本确认

                    list.add(tabInfo)
                    HookEnv.base.log(Log.INFO, TAG, "[UpdateTabEntry] injected tab: $UPDATE_TAG")
                    return@hooked list
                }
        }.onFailure {
            HookEnv.base.log(Log.WARN, TAG, "[UpdateTabEntry] TabInfo hook 失败: ${it.message}", null)
        }
    }

    private fun hookTabSelection() {
        runCatching {
            // 主界面 Tab 选中回调 — 需要根据实际版本确认类名和方法签名
            // 常见模式：BottomNavigationView.OnNavigationItemSelectedListener
            // 或自定义的 ViewPager 切换逻辑
            val mainActivity = ClassUtil.loadClass(
                "com.xiaomi.market.business_ui.main.MarketTabActivity"
            )
            // 拦截 ViewPager 切换，当目标是更新 Tab 时启动 Activity
            mainActivity.methodFinder()
                .filterByName("onTabSelected") // 需确认
                .first()
                .hooked {
                    val tag = args[0]?.invokeAs("getTag") as? String
                    if (tag == UPDATE_TAG) {
                        val ctx = (thisObject as? android.app.Activity) ?: return@hooked proceed()
                        val intent = Intent().apply {
                            setClassName(ctx, "com.xiaomi.market.ui.UpdateListActivity")
                            addFlags(Intent.FLAG_ACTIVITY_NO_ANIMATION)
                        }
                        ctx.startActivity(intent)
                        return@hooked null // 阻止 ViewPager 切换
                    }
                    proceed()
                }
        }.onFailure {
            HookEnv.base.log(Log.WARN, TAG, "[UpdateTabEntry] TabSelection hook 失败: ${it.message}", null)
        }
    }
}
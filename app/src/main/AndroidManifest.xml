<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 检查更新需要联网读取 GitHub Releases -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 直接下载并安装自身更新包（Android 8+ 装未知来源包必需） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
        关于「隐藏桌面图标」的实现要点（重要）：

        旧实现直接禁用 MainActivity 自身，而它同时承载了 MAIN+LAUNCHER，
        导致框架（LSPosed 等）也无法解析到任何入口，模块主页彻底进不去。

        现在的拆分：
          1. MainActivity 注册 MAIN + CATEGORY_INFO（外加 Xposed 遗留的 MODULE_SETTINGS）。
             - CATEGORY_INFO 不会在桌面抽屉出现（桌面只认 LAUNCHER 类目）；
             - 而 PackageManager.getLaunchIntentForPackage() 的解析顺序是
               「先查 MAIN+INFO，查不到才回退 MAIN+LAUNCHER」，
               因此框架仍能拿到指向 MainActivity 的 Intent，主页可正常打开；
             - MainActivity 永远不被禁用。
          2. .LauncherAlias 是单独的 activity-alias，唯一承载 MAIN+LAUNCHER，
             隐藏 / 恢复桌面图标只切换这个 alias 的启用状态。

        另外补充 EntryGuardReceiver：若用户此前已被旧版本锁出（MainActivity 处于禁用态），
        覆盖安装时收到 MY_PACKAGE_REPLACED 会自动把 MainActivity 重新启用，完成自愈。
    -->
    <application
        android:name=".App"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:description="@string/xposed_desc"
        android:roundIcon="@mipmap/ic_launcher_round">

        <!-- 真实主页：对桌面不可见，但对框架可见 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/AppTheme"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.INFO" />
                <!-- 兼容传统 Xposed / 部分管理器的显式入口类目 -->
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>

        <!-- 关于页：不声明 intent-filter，只能由主页显式跳转进入 -->
        <activity
            android:name=".AboutActivity"
            android:theme="@style/AppTheme"
            android:label="@string/about_title"
            android:exported="false" />

        <activity
            android:name=".SearchActivity"
            android:exported="false"
            android:theme="@style/AppTheme"
            android:windowSoftInputMode="stateHidden|adjustResize" />
        <!--
            二级设置页：主页只留高频开关，「我的」页 / 底部标签栏 / 其他净化 / 模块自身
            各自收在这里。用同一个 Activity，具体显示哪一组由 EXTRA_PAGE 决定，
            因此不声明 intent-filter，只能由主页显式跳转进入。
        -->
        <activity
            android:name=".SubSettingsActivity"
            android:theme="@style/AppTheme"
            android:exported="false" />

        <!-- 桌面入口：隐藏/恢复图标时只操作这个 alias -->
        <activity-alias
            android:name=".LauncherAlias"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="true"
            android:theme="@style/AppTheme"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 自愈：覆盖安装后确保主页入口处于启用状态，避免旧版本遗留的锁出 -->
        <receiver
            android:name=".EntryGuardReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 更新包安装：向系统安装器临时暴露本地 APK（Android 7+ 禁止 file://） -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.mars.mimarketpurify.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
